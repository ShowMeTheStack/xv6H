#!/bin/sh
### BEGIN INIT INFO
# Provides:          syslogd
# Required-Start:
# Default-Start:     2
# Short-Description: the system log daemon
### END INIT INFO
. /lib/init/functions

NAME=syslogd
DAEMON=/bin/syslogd
PIDFILE=/var/run/syslogd.pid

case "$1" in
start)
	log_daemon_msg "Starting $NAME"
	start_daemon "$DAEMON" || true
	log_end_msg $?
	;;
stop)
	log_daemon_msg "Stopping $NAME"
	killproc "$NAME" "$PIDFILE"
	log_end_msg $?
	;;
restart|force-reload)
	"$0" stop
	"$0" start
	;;
status)
	status_of_proc "$NAME" "$PIDFILE"
	;;
*)
	echo "usage: $0 {start|stop|restart|status}" >&2
	exit 1
	;;
esac
