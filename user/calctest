#!/bin/sh
# bc and expr: arbitrary precision arithmetic, and the one-expression
# calculator the shell reaches for.

passed=0
failed=0

check() {
	# check NAME EXPECTED ACTUAL
	if [ "$2" = "$3" ]; then
		passed=$((passed + 1))
	else
		failed=$((failed + 1))
		echo "FAIL $1: wanted [$2] got [$3]"
	fi
}

tmp=/tmp/calctest
rm -rf $tmp
mkdir -p $tmp
cd $tmp

# ---- expr ----

check expr_add 7 "$(expr 3 + 4)"
check expr_sub -1 "$(expr 3 - 4)"
check expr_mul 12 "$(expr 3 \* 4)"
check expr_div 2 "$(expr 9 / 4)"
check expr_mod 1 "$(expr 9 % 4)"
check expr_prec 14 "$(expr 2 + 3 \* 4)"
check expr_paren 20 "$(expr \( 2 + 3 \) \* 4)"
check expr_neg -6 "$(expr -2 \* 3)"

check expr_eq 1 "$(expr 3 = 3)"
check expr_ne 1 "$(expr 3 != 4)"
check expr_lt 1 "$(expr 3 \< 4)"
check expr_ge 0 "$(expr 3 \>= 4)"
check expr_str_cmp 1 "$(expr abc = abc)"
check expr_str_lt 1 "$(expr abc \< abd)"

check expr_or_left a "$(expr a \| b)"
check expr_or_right b "$(expr '' \| b)"
check expr_or_zero b "$(expr 0 \| b)"
check expr_and 'a' "$(expr a \& b)"
check expr_and_zero 0 "$(expr '' \& b)"

check expr_length 5 "$(expr length abcde)"
check expr_substr bcd "$(expr substr abcde 2 3)"
check expr_index 3 "$(expr index abcde c)"
check expr_index_none 0 "$(expr index abcde z)"
check expr_match 3 "$(expr match abcde 'abc')"
check expr_colon 3 "$(expr abcde : 'abc')"
check expr_group bc "$(expr abcde : 'a\(bc\)')"
check expr_nomatch 0 "$(expr abcde : 'xyz')"

# the exit status is the value, which is what makes expr useful in a
# shell: zero when the answer is neither empty nor zero
check expr_status_true 0 "$(expr 1 = 1 > /dev/null; echo $?)"
check expr_status_false 1 "$(expr 1 = 2 > /dev/null; echo $?)"
check expr_status_empty 1 "$(expr '' \| '' > /dev/null 2>&1; echo $?)"

# ---- bc: whole numbers ----

check bc_add 3 "$(echo '1 + 2' | bc)"
check bc_sub -1 "$(echo '1 - 2' | bc)"
check bc_mul 6 "$(echo '2 * 3' | bc)"
check bc_div 2 "$(echo '7 / 3' | bc)"
check bc_mod 1 "$(echo '7 % 3' | bc)"
check bc_pow 1024 "$(echo '2 ^ 10' | bc)"
check bc_prec 7 "$(echo '1 + 2 * 3' | bc)"
check bc_paren 9 "$(echo '(1 + 2) * 3' | bc)"
check bc_unary -5 "$(echo '-5' | bc)"
check bc_nested 512 "$(echo '2 ^ 3 ^ 2' | bc)"

# the whole point: numbers far past what a machine word holds
check bc_big 1267650600228229401496703205376 "$(echo '2 ^ 100' | bc)"
# a long number comes back wrapped at seventy columns with a
# backslash, as bc has always written them; both go before the count
check bc_big_digits 302 "$(echo '2 ^ 1000' | bc | tr -d '\n\\' | wc -c | tr -d ' ')"
check bc_wraps ok "$(echo '2 ^ 1000' | bc | grep -c '\\$' | sed 's/^4$/ok/')"
check bc_factorial_20 2432902008176640000 "$(echo 'define f(n) { if (n <= 1) return (1); return (n * f(n - 1)) }
f(20)' | bc)"
check bc_big_add 100000000000000000000000000000000 \
	"$(echo '99999999999999999999999999999999 + 1' | bc)"
check bc_big_mul 1000000000000000000000000000000000000000000000000 \
	"$(echo '1000000000000000000000000 * 1000000000000000000000000' | bc)"
check bc_big_sub 1 "$(echo '10000000000000000000000000 - 9999999999999999999999999' | bc)"
check bc_big_div 100000000000000000000000 \
	"$(echo '10000000000000000000000000 / 100' | bc)"

# ---- bc: the scale ----

check bc_scale_default 0 "$(echo 'scale' | bc)"
check bc_div_trunc 0 "$(echo '1 / 3' | bc)"
check bc_scale_3 .333 "$(echo 'scale = 3
1 / 3' | bc)"
check bc_scale_10 .3333333333 "$(echo 'scale = 10
1 / 3' | bc)"
check bc_scale_add 3.75 "$(echo '1.5 + 2.25' | bc)"
check bc_scale_mul 3.375 "$(echo 'scale = 3
1.5 * 2.25' | bc)"
check bc_scale_fn 2 "$(echo 'scale(1.25)' | bc)"
check bc_scale_keeps 1.50 "$(echo '1.50 + 0.00' | bc)"

# sqrt, to as many places as asked for
check bc_sqrt 3 "$(echo 'sqrt(9)' | bc)"
check bc_sqrt_scale 1.4142135623 "$(echo 'scale = 10
sqrt(2)' | bc)"
check bc_sqrt_20 1.41421356237309504880 "$(echo 'scale = 20
sqrt(2)' | bc)"
check bc_sqrt_big 1000000000000 "$(echo 'sqrt(1000000000000000000000000)' | bc)"

check bc_length 5 "$(echo 'length(12345)' | bc)"
check bc_length_frac 4 "$(echo 'length(1.234)' | bc)"

# ---- bc: variables, control and functions ----

check bc_var 7 "$(echo 'x = 3
y = 4
x + y' | bc)"
check bc_quiet '' "$(echo 'x = 3' | bc)"
check bc_incr 4 "$(echo 'x = 3
++x' | bc)"
check bc_postincr '3
4' "$(echo 'x = 3
x++
x' | bc)"
check bc_compound 12 "$(echo 'x = 3
x *= 4
x' | bc)"
check bc_array 30 "$(echo 'a[0] = 10
a[1] = 20
a[0] + a[1]' | bc)"

check bc_if yes "$(echo 'if (1 < 2) { print "yes\n" }' | bc)"
check bc_else no "$(echo 'if (1 > 2) { print "yes\n" } else { print "no\n" }' | bc)"
check bc_while 55 "$(echo 's = 0
i = 1
while (i <= 10) { s = s + i; i = i + 1 }
s' | bc)"
check bc_for 3628800 "$(echo 'p = 1
for (i = 1; i <= 10; i++) { p = p * i }
p' | bc)"
check bc_break 5 "$(echo 'i = 0
while (1) { i = i + 1; if (i == 5) break }
i' | bc)"

check bc_define 25 "$(echo 'define sq(x) { return (x * x) }
sq(5)' | bc)"
check bc_define_auto 6 "$(echo 'define f(n) { auto t
  t = n + 1
  return (t + 2) }
f(3)' | bc)"
check bc_recursion 120 "$(echo 'define f(n) { if (n <= 1) return (1); return (n * f(n - 1)) }
f(5)' | bc)"
check bc_two_args 7 "$(echo 'define add(a, b) { return (a + b) }
add(3, 4)' | bc)"
# a local must not survive the call
check bc_auto_scoped 9 "$(echo 't = 9
define f(n) { auto t
  t = 1
  return (n) }
f(0)
t' | bc | tail -1)"

check bc_print_str 'hi there' "$(echo 'print "hi there"' | bc)"
check bc_comparison 1 "$(echo '3 > 2' | bc)"
check bc_logic 1 "$(echo '1 && 1' | bc)"
check bc_not 1 "$(echo '!0' | bc)"

# ---- bc: the bases ----

check bc_obase_2 1010 "$(echo 'obase = 2
10' | bc)"
check bc_obase_16 FF "$(echo 'obase = 16
255' | bc)"
check bc_ibase_16 255 "$(echo 'ibase = 16
FF' | bc)"
check bc_obase_16_big 3E8 "$(echo 'obase = 16
1000' | bc)"

# ---- bc: from a file, and the maths library ----

printf 'x = 6\ny = 7\nx * y\n' > prog.bc
check bc_file 42 "$(bc prog.bc)"
check bc_l_scale 20 "$(echo 'scale' | bc -l)"
check bc_l_e ok "$(echo 'scale = 5
e(1)' | bc -l | grep -c '^2.718' | sed 's/^1$/ok/')"
check bc_l_sqrt2 ok "$(echo 'scale = 5
sqrt(2)' | bc -l | grep -c '^1.4142' | sed 's/^1$/ok/')"

# ---- what the shell reaches for ----

check bc_in_shell 30 "$(echo "$(echo '5 * 6' | bc)")"
check expr_in_loop 5 "$(i=0; while [ $i -lt 5 ]; do i=$(expr $i + 1); done; echo $i)"

cd /
rm -rf $tmp
echo "calctest: $((passed + failed)) checks, $failed failures"
if [ "$failed" = "0" ]; then
	exit 0
fi
exit 1
