xv6H patch 0005: a description-bound root interrupt controller (F1 the controller's
kind, F2 its address; L2). drivers/irqchip/irq-xv6h-vic.c: one flat irq domain that
every device line of the machine hangs from, with a PLIC, APLIC-direct or
APLIC-MSI+IMSIC backend chosen from the description (compatible "xv6h,vic",
property xv6h,kind) and re-chosen by xv6h_vic_rebind() when the machrev driver reads
a revised description; every line's enable, type and cpu are re-applied from the
driver's own records on every hart. IPIs stay the kernel's SBI IPIs, the timer stays
Sstc or SBI, so the channel a revision arrives on is independent of the controller.

--- a/drivers/irqchip/Kconfig
+++ b/drivers/irqchip/Kconfig
@@ -595,6 +595,18 @@
 	select IRQ_DOMAIN_HIERARCHY
 	select GENERIC_IRQ_EFFECTIVE_AFF_MASK if SMP
 
+config XV6H_VIC
+	bool "xv6H description-bound interrupt controller"
+	depends on RISCV
+	default y
+	select IRQ_DOMAIN_HIERARCHY
+	select GENERIC_IRQ_EFFECTIVE_AFF_MASK if SMP
+	help
+	  A root interrupt controller for a guest of the xv6H hypervisor whose
+	  controller -- a PLIC, an APLIC, or an APLIC with IMSICs -- and its
+	  address are facts of a revisable machine description. One irq domain,
+	  the backend chosen from the description and re-chosen when it changes.
+
 config STARFIVE_JH8100_INTC
 	bool "StarFive JH8100 External Interrupt Controller"
 	depends on ARCH_STARFIVE || COMPILE_TEST
--- a/drivers/irqchip/Makefile
