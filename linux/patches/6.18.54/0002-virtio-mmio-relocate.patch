+/*
+ * xv6H: the device's register window and its interrupt line are facts of the
+ * machine's description, and the hypervisor may revise them under the running
+ * guest (a machine that arrives on a host with another device map). The
+ * device and its queues are the host's and stay as they are; this driver only
+ * has to look somewhere else. Called by the machrev driver once it has read
+ * the new description; the old window is still answered by the host until the
+ * revision is acknowledged, so a driver touching it meanwhile is not hurt.
+ */
+int virtio_mmio_relocate(struct platform_device *pdev, resource_size_t base, int virq)
+{
+	struct virtio_mmio_device *vm_dev = platform_get_drvdata(pdev);
+	void __iomem *nb, *ob;
+	int old_irq, rc = 0;
+
+	if (!vm_dev)
+		return -ENODEV;
+	nb = ioremap(base, 0x1000);
+	if (!nb)
+		return -ENOMEM;
+	old_irq = vm_dev->irq;
+	if (old_irq > 0 && !list_empty(&vm_dev->vdev.vqs)) {
+		free_irq(old_irq, vm_dev);
+		rc = request_irq(virq, vm_interrupt, IRQF_SHARED, dev_name(&vm_dev->vdev.dev), vm_dev);
+		if (rc)
+			dev_err(&pdev->dev, "relocate: irq %d: %d\n", virq, rc);
+	}
+	vm_dev->irq = virq;
+	ob = vm_dev->base;
+	vm_dev->base = nb;
+	{	/* the platform resource follows, so the device can be found by where it is */
+		struct resource *r = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+		if (r) {
+			resource_size_t n = resource_size(r);
+			r->start = base;
+			r->end = base + n - 1;
+		}
+	}
+	dev_info(&pdev->dev, "relocated to %pa, irq %d\n", &base, virq);
+	(void)ob;	/* the devm mapping of the boot window stays until the device goes */
+	return rc;
+}
+EXPORT_SYMBOL_GPL(virtio_mmio_relocate);
+
+/* xv6H: the virtio device behind a virtio-mmio platform device (machrev reads
+ * a moved device's configuration -- its MAC -- through it) */
+struct virtio_device *virtio_mmio_vdev(struct platform_device *pdev)
+{
+	struct virtio_mmio_device *vm_dev = platform_get_drvdata(pdev);
+
+	return vm_dev ? &vm_dev->vdev : NULL;
+}
+EXPORT_SYMBOL_GPL(virtio_mmio_vdev);
