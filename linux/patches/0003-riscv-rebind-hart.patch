+int plic_rebind_hart(unsigned int cpu, unsigned long hartid);
+
+int riscv_rebind_hart(unsigned int cpu, unsigned long hartid)
+{
+	unsigned long old;
 
+	if (cpu >= NR_CPUS)
+		return -EINVAL;
+	old = cpuid_to_hartid_map(cpu);
+	if (old == hartid)
+		return 0;
+	cpuid_to_hartid_map(cpu) = hartid;
+	pr_info("smp: cpu%u: hart %lu -> %lu\n", cpu, old, hartid);
+	return plic_rebind_hart(cpu, hartid);
+}
+EXPORT_SYMBOL_GPL(riscv_rebind_hart);
