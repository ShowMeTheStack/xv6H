+/*
+ * xv6H: the machine's description renumbered its harts (F9). This cpu's
+ * interrupt file is the page of the hart it is now called, and every MSI
+ * message that named the old page -- the APLIC's targets for wired lines --
+ * is composed and written again against the new one. The file's own state
+ * (enables, pending) belongs to the vcpu and moves with the hart number on
+ * the hypervisor's side; nothing here is lost.
+ */
+int imsic_rebind_hart(unsigned int cpu, unsigned long hartid)
+{
+	struct imsic_local_config *local;
+	struct imsic_local_priv *lpriv;
+	phys_addr_t pa;
+	void __iomem *va;
+	unsigned int i;
+
+	if (!imsic)
+		return -ENODEV;
+	local = per_cpu_ptr(imsic->global.local, cpu);
+	pa = imsic->global.base_addr +
+	     ((phys_addr_t)hartid << (imsic->global.guest_index_bits + IMSIC_MMIO_PAGE_SHIFT));
+	if (pa == local->msi_pa)
+		return 0;
+	va = ioremap(pa, IMSIC_MMIO_PAGE_SZ);
+	if (!va)
+		return -ENOMEM;
+	local->msi_pa = pa;
+	local->msi_va = va;
+	/* the hart index field has to hold the new number: an APLIC that parsed
+	 * hart-index-bits 1 for harts 0,1 cannot address hart 4's file (it warned
+	 * and masked the index to 0, and the machine's interrupts went to a hart
+	 * that no longer existed) */
+	if (fls((unsigned int)hartid) > imsic->global.hart_index_bits)
+		imsic->global.hart_index_bits = fls((unsigned int)hartid);
+
+	lpriv = per_cpu_ptr(imsic->lpriv, cpu);
+	for (i = 1; i <= imsic->global.nr_ids; i++) {
+		struct imsic_vector *vec = &lpriv->vectors[i];
+		struct irq_data *d;
+		struct msi_msg msg;
+
+		if (!vec->hwirq || vec->hwirq == UINT_MAX)
+			continue;
+		d = irq_get_irq_data(vec->hwirq);
+		if (!d)
+			continue;
+#ifdef CONFIG_RISCV_APLIC_MSI
+		aplic_msi_hart_index_bits(d, imsic->global.hart_index_bits);
+#endif
+		if (d->chip && d->chip->irq_write_msi_msg && irq_chip_compose_msi_msg(d, &msg) == 0)
+			d->chip->irq_write_msi_msg(d, &msg);
+	}
+	pr_info("riscv-imsic: cpu%u now hart %lu: interrupt file at %pa\n", cpu, hartid, &pa);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(imsic_rebind_hart);
