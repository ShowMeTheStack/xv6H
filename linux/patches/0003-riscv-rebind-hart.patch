+
+/*
+ * xv6H: a hart's id is a fact of the machine's description and may be revised
+ * under the running guest (F9). This cpu's PLIC context is 2*hartid+1, so its
+ * enables and threshold live somewhere else now: copy the enables from the
+ * old context, point the handler at the new one, write them there, set the
+ * threshold. Any cpu may do this for any other; the registers are memory.
+ */
+int plic_rebind_hart(unsigned int cpu, unsigned long hartid)
+{
+	struct plic_handler *handler = per_cpu_ptr(&plic_handlers, cpu);
+	struct plic_priv *priv;
+	unsigned long flags;
+	int i, context_id = 2 * hartid + 1;
+	u32 words;
 
+	if (!handler->present || !handler->enable_save)
+		return -ENODEV;
+	priv = handler->priv;
+	words = DIV_ROUND_UP(priv->nr_irqs, 32);
+	raw_spin_lock_irqsave(&handler->enable_lock, flags);
+	for (i = 0; i < words; i++)
+		handler->enable_save[i] = readl(handler->enable_base + i * sizeof(u32));
+	handler->hart_base = priv->regs + CONTEXT_BASE + context_id * CONTEXT_SIZE;
+	handler->enable_base = priv->regs + CONTEXT_ENABLE_BASE + context_id * CONTEXT_ENABLE_SIZE;
+	for (i = 0; i < words; i++)
+		writel(handler->enable_save[i], handler->enable_base + i * sizeof(u32));
+	raw_spin_unlock_irqrestore(&handler->enable_lock, flags);
+	plic_set_threshold(handler, PLIC_ENABLE_THRESHOLD);
+	pr_info("riscv-plic: cpu%u now hart %lu (context %d)\n", cpu, hartid, context_id);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(plic_rebind_hart);
