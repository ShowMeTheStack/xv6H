+int plic_rebind_hart(unsigned int cpu, unsigned long hartid);
+int imsic_rebind_hart(unsigned int cpu, unsigned long hartid);
+
+int riscv_rebind_hart(unsigned int cpu, unsigned long hartid)
+{
+	unsigned long old;
+	int rc = 0, rc2;
 
+	if (cpu >= NR_CPUS)
+		return -EINVAL;
+	old = cpuid_to_hartid_map(cpu);
+	if (old == hartid)
+		return 0;
+	cpuid_to_hartid_map(cpu) = hartid;
+	pr_info("smp: cpu%u: hart %lu -> %lu\n", cpu, old, hartid);
+#ifdef CONFIG_RISCV_IMSIC
+	rc = imsic_rebind_hart(cpu, hartid);	/* its interrupt file and the MSI targets naming it */
+#endif
+	rc2 = plic_rebind_hart(cpu, hartid);
+	/* a controller this machine does not have is not a failure of the renumbering
+	 * (the IMSIC machine's second renumbering was skipped on the PLIC's -ENODEV) */
+	if (rc == -ENODEV)
+		rc = 0;
+	if (rc2 == -ENODEV)
+		rc2 = 0;
+	return rc ? rc : rc2;
+}
+EXPORT_SYMBOL_GPL(riscv_rebind_hart);
