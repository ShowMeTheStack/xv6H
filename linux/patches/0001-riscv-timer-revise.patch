+/*
+ * xv6H: the counters rate is a fact of the machines description and may
+ * be revised under a running kernel (the hypervisor scales the counter it
+ * shows the guest, continuously). sched_clock_register() is __init and
+ * refuses a lower rate; this re-rates the registered clock in place, with
+ * the epoch carried over so that sched_clock() never goes backwards. Called
+ * by riscv_timer_revise() after the clocksource has been re-rated.
+ */
+void sched_clock_revise(unsigned long rate)
+{
+	u64 wrap, cyc, ns;
+	u32 new_mult, new_shift;
+	unsigned long flags;
+	struct clock_read_data rd;
+
+	if (!rate || rate == cd.rate)
+		return;
+
+	local_irq_save(flags);
+
+	clocks_calc_mult_shift(&new_mult, &new_shift, rate, NSEC_PER_SEC, 3600);
+
+	rd = cd.read_data[0];
+	cyc = cd.actual_read_sched_clock();
+	ns = rd.epoch_ns + cyc_to_ns((cyc - rd.epoch_cyc) & rd.sched_clock_mask, rd.mult, rd.shift);
+
+	rd.mult = new_mult;
+	rd.shift = new_shift;
+	rd.epoch_cyc = cyc;
+	rd.epoch_ns = ns;
+	cd.rate = rate;
+
+	wrap = clocks_calc_max_nsecs(new_mult, new_shift, 0, rd.sched_clock_mask, NULL);
+	cd.wrap_kt = ns_to_ktime(wrap);
+
+	update_clock_read_data(&rd);
+
+	if (sched_clock_timer.function != NULL)
+		hrtimer_start(&sched_clock_timer, cd.wrap_kt, HRTIMER_MODE_REL_HARD);
+
+	local_irq_restore(flags);
+
+	pr_info("sched_clock: re-rated to %lu Hz, epoch %llu ns at cyc %llu, mult %u shift %u (was mult %u shift %u)\n",
+		rate, ns, cyc, new_mult, new_shift, cd.read_data[0].mult, cd.read_data[0].shift);
+}
+EXPORT_SYMBOL_GPL(sched_clock_revise);
