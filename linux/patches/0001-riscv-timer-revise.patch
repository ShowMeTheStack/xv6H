+/*
+ * xv6H: the running clocksource's rate is a fact of the machine's
+ * description and may be revised under the kernel (F6). Updating the
+ * clocksource's mult/shift alone does not reach the timekeeper, which
+ * copied them at setup; re-base it on the same clocksource exactly as a
+ * clocksource change would, with the elapsed time carried forward.
+ */
+void timekeeping_rerate(void)
+{
+	struct timekeeper *tk = &tk_core.timekeeper;
+
+	stop_machine(change_clocksource, tk->tkr_mono.clock, NULL);
+	tick_clock_notify();
+}
+EXPORT_SYMBOL_GPL(timekeeping_rerate);
