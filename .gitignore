_*
*.o
# the compiler's dependency files -- but not a directory whose name
# ends in .d, which is what etc/init.d, etc/rc.d and etc/cron.d are.
# Ignoring those kept every init script out of the repository, and a
# fresh clone could not be built.
*.d
!*.d/
*.asm
*.sym
*.img
/mkfs/mkfs
/kernel/kernel
/user/usys.S
.gdbinit
TAGS
guest*.img
guest/kernel
guest/badguest
guest/fuzzguest
guest/*.o
test-hyp.log
guest/disk*.img
guest/hello
guest/hello.bin
test-fs*.img
linux/Image*
linux/linux.img
guest/fdguest
guest/vguest
guest/vmbench
mig*.img
mig*.sock
tls/obj/
tls/libbearssl.a
user/tls_date.h
build/
user/*.so
user/ld.so
user/static/
user/libc.a
mkfs/mkext4
mkfs/mkpasswd
.DS_Store
dbg.log
user/syscallnames.h

# what the test harness leaves behind: one log per run, one per job, and
# the copies of the file system each job boots from.
/test-hyp.log
# TEST_LOG=<name> puts a run's console somewhere else
/*.log
/qresults.txt
